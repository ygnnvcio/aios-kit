{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-outward.sh\"",
            "timeout": 10,
            "statusMessage": "Chequeando accion hacia afuera"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commit-ajeno.sh\"",
            "timeout": 10,
            "statusMessage": "Chequeando que el commit no traiga lineas de otra sesion"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/token-stop.py\" --aviso-m 30 --stop-m 60 --aviso-ctx 120000 --stop-ctx 160000",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
